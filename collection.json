    {
      "name": "7. Send Documents - Multiple Templates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"templateIds\": [\"1000001\", \"1000002\", \"1000003\", \"1000004\"],\n  \"submitters\": [\n    {\n      \"email\": \"buyer@test.com\",\n      \"name\": \"John Smith\",\n      \"role\": \"Buyer\"\n    },\n    {\n      \"email\": \"seller@test.com\",\n      \"name\": \"Jane Doe\",\n      \"role\": \"Seller\"\n    }\n  ],\n  \"values\": {\n    \"BuyerFullName\": \"John Smith\",\n    \"SellerFullName\": \"Jane Doe\",\n    \"PurchasePrice\": \"520000\",\n    \"EMD\": \"15600\",\n    \"CloseDate\": \"2025-01-15\",\n    \"PropertyAddress\": \"1234 Main Street, Baltimore MD 21201\",\n    \"FinancingType\": \"Conventional\",\n    \"InspectionDays\": \"7\",\n    \"PropertyYearBuilt\": \"1975\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/send-docs",
          "host": ["{{baseUrl}}"],
          "path": ["send-docs"]
        },
        "description": "Test sending multiple document templates with complete field values"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains multiple submissions', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('submissions');",
              "    pm.expect(jsonData.submissions).to.be.an('array');",
              "    pm.expect(jsonData.submissions.length).to.be.greaterThan(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Approve Action",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"actionId\": \"action-123\",\n  \"action\": \"send-docs\",\n  \"payload\": {\n    \"suggestedDocs\": [\"md-residential-contract\"]\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/approve",
          "host": ["{{baseUrl}}"],
          "path": ["approve"]
        },
        "description": "Test action approval workflow - Note: This will return 404 if action doesn't exist, which is expected behavior"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 404', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test('Response contains action', function () {",
              "        const jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('action');",
              "    });",
              "} else if (pm.response.code === 404) {",
              "    pm.test('Response contains error message', function () {",
              "        const jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('error');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8b. Approve Action - Complete Workflow",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"Offer 520k, 3% EMD, close in 30 days, conventional financing, 7-day inspection at 1234 Main Street, Baltimore MD. Buyer is John Smith (john@email.com), seller is Jane Doe (jane@email.com). Property built in 1975.\",\n  \"jurisdiction\": \"MD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "First create a session with actions, then approve one"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains actions', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('reply');",
              "    pm.expect(jsonData.reply).to.have.property('proposedActions');",
              "    pm.expect(jsonData.reply.proposedActions).to.be.an('array');",
              "});",
              "",
              "// Store action ID for next request",
              "if (pm.response.json().reply.proposedActions.length > 0) {",
              "    pm.globals.set('actionId', pm.response.json().reply.proposedActions[0].id);",
              "    console.log('Stored action ID:', pm.globals.get('actionId'));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8c. Approve Action - Execute",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"actionId\": \"{{actionId}}\",\n  \"action\": \"send-docs\",\n  \"payload\": {\n    \"suggestedDocs\": [\"md-residential-contract\"]\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/approve",
          "host": ["{{baseUrl}}"],
          "path": ["approve"]
        },
        "description": "Execute the approved action from previous step"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains action and result', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('action');",
              "    pm.expect(jsonData).to.have.property('result');",
              "});",
              "",
              "pm.test('Result contains submission data', function () {",
              "    const jsonData = pm.response.json();",
              "    if (jsonData.result) {",
              "        pm.expect(jsonData.result).to.have.property('submissionIds');",
              "        pm.expect(jsonData.result.submissionIds).to.be.an('array');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
