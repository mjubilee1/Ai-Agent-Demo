    {
      "name": "3. Chat - Complete Deal Intent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"Offer 520k, 3% EMD, close in 30 days, conventional financing, 7-day inspection at 1234 Main Street, Baltimore MD. Buyer is John Smith (john@email.com), seller is Jane Doe (jane@email.com). Property built in 1975.\",\n  \"jurisdiction\": \"MD\",\n  \"context\": {\n    \"selectedDocs\": [\"md-residential-contract\", \"financing-addendum\", \"inspection-addendum\"],\n    \"parties\": {\n      \"buyer\": {\n        \"name\": \"John Smith\",\n        \"email\": \"john@email.com\"\n      },\n      \"seller\": {\n        \"name\": \"Jane Doe\",\n        \"email\": \"jane@email.com\"\n      }\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/chat",
          "host": ["{{baseUrl}}"],
          "path": ["chat"]
        },
        "description": "Test chat endpoint with complete deal information"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains actions', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('actions');",
              "    pm.expect(jsonData.actions).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
