        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"templateIds\": [\"1000001\"],\n  \"submitters\": [\n    {\n      \"email\": \"buyer@test.com\",\n      \"name\": \"John Buyer\",\n      \"role\": \"Buyer\"\n    },\n    {\n      \"email\": \"seller@test.com\",\n      \"name\": \"Jane Seller\",\n      \"role\": \"Seller\"\n    }\n  ],\n  \"values\": {\n    \"BuyerFullName\": \"John Buyer\",\n    \"SellerFullName\": \"Jane Seller\",\n    \"PurchasePrice\": \"520000\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/send-docs",
          "host": ["{{baseUrl}}"],
          "path": ["send-docs"]
        },
        "description": "Test document sending with basic template"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
