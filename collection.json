    {
      "name": "5. Parse Intent - Complex",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"I want to make an offer on 1234 Main Street for 520 thousand dollars with 3 percent earnest money deposit, conventional financing, close in 30 days, 7-day inspection period. Buyer is John Smith at john@email.com, seller is Jane Doe at jane@email.com. The property was built in 1975.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/parse-intent",
          "host": ["{{baseUrl}}"],
          "path": ["parse-intent"]
        },
        "description": "Test intent parsing with complex natural language input"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains detailed entities', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('entities');",
              "    pm.expect(jsonData.entities).to.have.property('price');",
              "    pm.expect(jsonData.entities).to.have.property('emd');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Send Documents - Basic",
      "request": {
        "method": "POST",
        "header": [
